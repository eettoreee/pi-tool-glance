  "description": "Compact, Codex-style, and full tool views for Pi, selected or cycled with /toolview.",
  "type": "module",
  "license": "MIT",
  "author": "eettoreee",
  "repository": {
    "type": "git",
    "url": "https://github.com/eettoreee/pi-tool-glance.git"
  },
  "homepage": "https://github.com/eettoreee/pi-tool-glance#readme",
  "bugs": {
    "url": "https://github.com/eettoreee/pi-tool-glance/issues"
  },
  "keywords": ["pi-package", "pi", "extension", "terminal", "tool-rendering", "codex"],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": ["extensions/", "examples/", "README.md", "CHANGELOG.md", "LICENSE"],
